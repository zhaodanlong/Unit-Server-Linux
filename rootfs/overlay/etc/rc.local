#!/bin/sh -e
#
# rc.local - 启动时加载驱动
#

# ============================================
# 1. 加载 SPI LCD 驱动 (ST7789VW 240x135)
# ============================================
# 内核内置的 fbtft 驱动使用错误的 GPIO (GPIO0/GPIO1)
# 我们需要加载模块版本并指定正确的 GPIO (GPIO12/GPIO11)
#
# 注意: 内置驱动无法卸载，但模块加载会覆盖 SPI 设备
# 忽略 "Driver already registered" 错误

# 尝试加载正确配置的驱动模块
modprobe fbtft_device custom name=fb_st7789vw busnum=0 mode=3 speed=50000000 gpios=dc:12,reset:11 2>&1 | grep -v "already registered" || true

# ============================================
# 2. 加载 WiFi 驱动 (RTL8723BU)
# ============================================
if ! lsmod | grep -q "8723bu"; then
    insmod /lib/modules/4.14.111/kernel/drivers/net/wireless/realtek/rtl8723bu/8723bu.ko 2>/dev/null || true
fi

# 等待 WiFi 接口出现
sleep 1

# 启动 WiFi 接口
for iface in /sys/class/net/wl*; do
    if [ -e "$iface" ]; then
        ifname=$(basename "$iface")
        ip link set "$ifname" up 2>/dev/null || true
    fi
done

# ============================================
# 3. 设置系统时间 (如果有网络)
# ============================================
# 尝试从 NTP 同步时间 (后台运行)
(sleep 30 && ntpdate -s pool.ntp.org 2>/dev/null || true) &

exit 0
